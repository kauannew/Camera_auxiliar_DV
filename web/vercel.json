{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/deteccoes",
      "destination": "https://camera-auxiliar-dv-backend.onrender.com/deteccoes"
    },
    {
      "source": "/obstaculos",
      "destination": "https://camera-auxiliar-dv-backend.onrender.com/obstaculos"
    },
    {
      "source": "/mapa",
      "destination": "https://camera-auxiliar-dv-backend.onrender.com/mapa"
    },
    {
      "source": "/saude",
      "destination": "https://camera-auxiliar-dv-backend.onrender.com/saude"
    }
  ]
}
