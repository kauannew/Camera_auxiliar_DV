# API Spring Boot
API_PORTA=8080
API_JAVA_OPTS=-Xmx384m
API_FUSO=America/Bahia

# openrouteservice: API pública da HeiGIT (chave em https://account.heigit.org). Nunca commitar a chave.
# Não usar api.openrouteservice.org: tem só 10% da cota e será desligado em 11/2026
ORS_URL=https://api.heigit.org/openrouteservice
ORS_API_KEY=
# Plano B (ORS próprio): ORS_URL=http://ors:8082/ors e "docker compose --profile ors-local up -d"

# Back da câmera: endereço que lista obstáculos (a API acrescenta ?bbox=minLon,minLat,maxLon,maxLat).
# Vazio: usa os obstáculos de teste fixos.
CAMERA_URL=
# Nível de cada classe que a câmera manda sem "passagem" (classe:nivel). Classe fora da lista vale bloqueada
CAMERA_PASSAGEM_POR_CLASSE=obstaculo_suspenso:bloqueada,buraco:dificil

# Áreas atendidas (minLon,minLat,maxLon,maxLat), várias separadas por ";" e os nomes na mesma ordem.
# Origem e destino têm de estar numa mesma área, senão 400. Vazio = mundo todo. Sem a linha = Salvador e Recife.
# Aspas porque o ";" quebraria quem lê o arquivo com "source"
# Exemplo: AREA_BBOX="-38.6995,-13.0174,-38.3034,-12.7336;-35.0200,-8.1600,-34.8600,-7.9300" e AREA_NOME="Salvador;Recife"
AREA_BBOX=
AREA_NOME=

# Domínios do front que podem chamar a API, separados por vírgula ("*" libera todos)
CORS_ORIGENS=*

# Página de teste com mapa em "/" (false esconde; a API e o Swagger continuam)
PAGINA_TESTE=true

# Rota
ROTA_PERFIS=foot-walking,wheelchair
# Perfil quando o pedido não diz qual (foot-walking para quem é cego, wheelchair para cadeirante)
ROTA_PERFIL_PADRAO=foot-walking
ROTA_CONFIANCA_MINIMA=0.6
# Lado do quadrado de cada obstáculo (cobre o erro do GPS)
ROTA_LADO_QUADRADO_METROS=12
# Passagem difícil: aceita o desvio se aumentar a rota em até X%, ou em até Y metros (o que for maior)
ROTA_DESVIO_PERCENTUAL=30
ROTA_DESVIO_PISO_METROS=100

# Legado (ORS próprio, só para o plano B e para recortar.sh)
OSM_REGIAO_URL=https://download.geofabrik.de/south-america/brazil/nordeste-latest.osm.pbf
OSM_REGIAO_ARQUIVO=nordeste-latest.osm.pbf
CIDADE_NOME=salvador
CIDADE_BBOX=-38.6995,-13.0174,-38.3034,-12.7336
ORS_VERSAO=v10.1.0
ORS_PORTA=8082
ORS_PBF=salvador.osm.pbf
ORS_XMS=256m
ORS_XMX=2g
ORS_PERFIL_FOOT_WALKING=true
ORS_PERFIL_WHEELCHAIR=true

# ORS próprio com o mapa de Salvador: usado primeiro dentro da cobertura dele (sem cota). Vazio desliga
# Local: http://localhost:8082/ors (subir com docker-compose.medir.yml). VPS/Docker: http://ors:8082/ors
ORS_LOCAL_URL=
